{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthDto"
                }
              }
            }
          },
          "401": {
            "description": ""
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/sessions": {
      "get": {
        "operationId": "ScheduleController_list",
        "parameters": [
          {
            "name": "week",
            "required": true,
            "in": "query",
            "description": "Any date in the requested Melbourne week (YYYY-MM-DD).",
            "schema": {
              "example": "2026-09-14",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LessonDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "Timetable"
        ]
      }
    },
    "/api/sessions/{id}/participants": {
      "get": {
        "operationId": "ScheduleController_roster",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "Timetable"
        ]
      }
    }
  },
  "info": {
    "title": "StudentSys API",
    "description": "Foundation: authentication and read-only timetable. Trial workflow is planned.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "student_session"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "database": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "timezone",
          "database"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "TEACHER"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "AuthDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "LessonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "classGroupId": {
            "type": "string"
          },
          "targetLevel": {
            "type": "string"
          },
          "courseName": {
            "type": "string"
          },
          "teacherName": {
            "type": "string"
          },
          "teacherId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "number"
          },
          "participantCount": {
            "type": "number"
          },
          "trialCount": {
            "type": "number"
          },
          "newCount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "id",
          "className",
          "classGroupId",
          "targetLevel",
          "courseName",
          "teacherName",
          "teacherId",
          "startsAt",
          "endsAt",
          "capacity",
          "participantCount",
          "trialCount",
          "newCount",
          "status"
        ]
      },
      "ParticipantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "yearLevel": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "TRIAL",
              "REGULAR"
            ]
          },
          "isNewToClass": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "yearLevel",
          "kind",
          "isNewToClass"
        ]
      },
      "RosterDto": {
        "type": "object",
        "properties": {
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantDto"
            }
          }
        },
        "required": [
          "participants"
        ]
      }
    }
  }
}
