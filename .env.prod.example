# Copy to .env.prod. Supply your production password; do not reuse .env.
POSTGRES_USER=student
POSTGRES_PASSWORD=
POSTGRES_DB=student_sys
IMAGE_TAG=local
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
# true behind HTTPS; false only when explicitly testing over local HTTP.
SESSION_COOKIE_SECURE=true
QIWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Required for account create/reset command fingerprints. Generate a random secret.
ACCOUNT_COMMAND_HASH_SECRET=
