{
  "name": "@student/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n types,server \"tsc -p tsconfig.dev.json --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist-dev/main.js\"",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "check": "prisma validate && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:init": "prisma db execute --file ../../sql/schema.sql",
    "db:seed": "pnpm --filter @student/common build && prisma db seed",
    "openapi:export": "node dist/openapi.js",
    "build:dev": "prisma generate && tsc -p tsconfig.dev.json",
    "dev:container": "pnpm --filter @student/common build && pnpm build:dev && concurrently -k -n common,api \"pnpm --filter @student/common dev\" \"pnpm dev\"",
    "accounts:bootstrap": "node dist/accounts/bootstrap-super-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.13.13",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5",
    "@student/common": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
