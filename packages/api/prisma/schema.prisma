generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum StudentType {
  TRIAL
  MEMBER
}

enum ParticipantKind {
  REGULAR
  TRIAL
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  BOOKED
  CANCELLED
}
enum Attendance {
  PENDING
  ATTENDED
  NO_SHOW
}
enum TaskType {
  TRIAL_FEEDBACK
  TRIAL_FOLLOWUP
  STUDENT_AI_REPORT
}
enum FollowupOutcome {
  PURCHASE_RECORDED
  NOT_PURCHASED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}
enum EntitlementBucket {
  TRIAL
  REGULAR
}
enum EntitlementKind {
  INITIAL_TRIAL
  TRIAL_GRANT
  PURCHASE
  CONSUMPTION
  MIGRATION
}

enum MembershipCategory {
  TRIAL_STUDENT
  NEW_MEMBER
  MEMBER
}
enum TaskPurpose {
  FIRST_PURCHASE
  POST_TRIAL_REVIEW
}

enum ReportGenerationStatus {
  NOT_STARTED
  READY
  FAILED
}

model User {
  status AccountStatus @default(ACTIVE)
  isSuperAdmin Boolean @default(false)
  version Int @default(1)
  disabledAt DateTime? @db.Timestamptz(3)
  accountActions AccountAudit[] @relation("AccountActor")
  accountHistory AccountAudit[] @relation("AccountTarget")
  id           String @id @default(cuid())
  email        String @unique
  name         String
  role         Role
  passwordHash String
  sessions     AuthSession[]
  students     Student[]
  studentAdminLinks StudentAdminLink[] @relation("ResponsibleAdmin")
  createdStudentLinks StudentAdminLink[] @relation("RecordingAdmin")
  lessons      ClassSession[]
  tasks        Task[]
  communications CommunicationLog[]
  changes ScheduleChange[]
  receipts MutationReceipt[]
  entitlementEntries EntitlementEntry[]
  checkedInParticipants SessionParticipant[] @relation("ParticipantCheckInActor")
}

model AuthSession {
  tokenHash String @id
  csrfToken String
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

model Student {
  type StudentType @default(TRIAL)
  gender String?
  age Int?
  id           String @id @default(cuid())
  name         String
  yearLevel    String
  ownerAdminId String
  owner        User @relation(fields: [ownerAdminId], references: [id])
  participants SessionParticipant[]
  adminLink StudentAdminLink?
  guardianOccupation String?
  guardianAge Int?
  guardianGender String?
  guardianName String?
  guardianRelationship String?
  guardianPhone String?
  guardianEmail String?
  guardianWechat String?
  preferredChannel String?
  preferredLanguage String @default("en-AU")
  backgroundHtml String?
  backgroundText String?
  adminNotesHtml String?
  adminNotesText String?
  aiReports StudentAiReport[]
  learningGoals String?
  preferredTimes String?
  interestedSubjects String?
  firstPurchasedAt DateTime? @db.Timestamptz(3)
  entitlementEntries EntitlementEntry[]
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  communications CommunicationLog[]
  changes ScheduleChange[]
  @@index([ownerAdminId])
}

// Current admin mirrors Student.ownerAdminId through a DB trigger during compatibility rollout.
// Recording admin is immutable once known; migrated records intentionally keep it null.
model StudentAdminLink {
  studentId String @id
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId String
  admin User @relation("ResponsibleAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  createdByAdminId String?
  createdByAdmin User? @relation("RecordingAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([adminId])
  @@index([createdByAdminId])
  @@unique([studentId, adminId], map: "StudentAdminLink_student_owner_key")
}

model Course {
  id       String @id @default(cuid())
  name     String @unique
  sessions ClassSession[]
}

model ClassGroup {
  id          String @id @default(cuid())
  name        String
  targetLevel String
  sessions    ClassSession[]
}

model ClassSession {
  id           String @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  courseId     String
  course       Course @relation(fields: [courseId], references: [id])
  teacherId    String
  teacher      User @relation(fields: [teacherId], references: [id])
  startsAt     DateTime @db.Timestamptz(3)
  endsAt       DateTime @db.Timestamptz(3)
  status       SessionStatus @default(SCHEDULED)
  participants SessionParticipant[]
  version Int @default(1)
  tasks Task[]
  changes ScheduleChange[] @relation("SourceSession")
  @@index([startsAt])
  @@index([teacherId, startsAt])
  @@index([classGroupId, startsAt])
}

model SessionParticipant {
  id           String @id @default(cuid())
  sessionId    String
  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student @relation(fields: [studentId], references: [id])
  // Funding card only; student identity is Student.type, never inferred from this field.
  kind         ParticipantKind @default(REGULAR)
  bookingStatus BookingStatus @default(BOOKED)
  attendance Attendance @default(PENDING)
  checkedInAt DateTime? @db.Timestamptz(3)
  checkedInBy String?
  checkInActor User? @relation("ParticipantCheckInActor", fields: [checkedInBy], references: [id], onDelete: Restrict)
  feedbackSubmittedAt DateTime? @db.Timestamptz(3)
  classroomPerformanceRating Decimal? @db.Decimal
  overallAbilityRating Decimal? @db.Decimal
  teacherNoteHtml String?
  teacherNoteText String?
  categorySnapshot String?
  membershipCategorySnapshot MembershipCategory?
  consumption EntitlementEntry?
  version Int @default(1)
  tasks Task[]
  communications CommunicationLog[]
  changes ScheduleChange[]
  @@unique([sessionId, studentId])
}

model Task {
  id String @id @default(cuid())
  type TaskType
  assigneeId String
  assignee User @relation(fields:[assigneeId], references:[id])
  sessionId String
  session ClassSession @relation(fields:[sessionId], references:[id])
  participantId String?
  participant SessionParticipant? @relation(fields:[participantId], references:[id])
  status TaskStatus @default(OPEN)
  followupOutcome FollowupOutcome?
  purpose TaskPurpose?
  resolvedByEntitlementEntryId String?
  resolvedByEntitlementEntry EntitlementEntry? @relation(fields: [resolvedByEntitlementEntryId], references: [id], onDelete: Restrict)
  reason String?
  sourceSnapshot Json?
  availableAt DateTime @db.Timestamptz(3)
  dueAt DateTime @db.Timestamptz(3)
  version Int @default(1)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  communications CommunicationLog[]
  aiReport StudentAiReport? @relation("ReportTask")
  sourcedReport StudentAiReport? @relation("ReportSource")
  @@index([assigneeId,status,availableAt,dueAt])
}
model CommunicationLog {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id])
  taskId String?
  task Task? @relation(fields:[taskId], references:[id])
  participantId String?
  participant SessionParticipant? @relation(fields:[participantId], references:[id])
  guardianNameSnapshot String
  relationshipSnapshot String?
  channel String
  noteHtml String?
  noteText String?
  purchaseIntentRating Decimal? @db.Decimal
  notPurchasedReasons String[] @default([])
  occurredAt DateTime @db.Timestamptz(3)
  createdBy String
  author User @relation(fields:[createdBy], references:[id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([taskId], map: "CommunicationLog_taskId_unique")
  @@index([studentId,occurredAt])
}
model ScheduleChange {
  id String @id @default(cuid())
  sessionId String
  session ClassSession @relation("SourceSession",fields:[sessionId], references:[id])
  studentId String?
  student Student? @relation(fields:[studentId], references:[id])
  participantId String?
  participant SessionParticipant? @relation(fields:[participantId], references:[id])
  actorId String
  actor User @relation(fields:[actorId], references:[id])
  action String
  reason String
  before Json
  after Json
  requestKey String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([sessionId,createdAt])
}
model MutationReceipt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id])
  operation String
  key String
  requestHash String
  response Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId,operation,key])
}

model EntitlementEntry {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  bucket EntitlementBucket
  kind EntitlementKind
  quantity Int
  participantId String? @unique
  participant SessionParticipant? @relation(fields: [participantId], references: [id], onDelete: Restrict)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  note String?
  packageId String?
  package LessonPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageSnapshot Json?
  resolvedTasks Task[]
  sourceKey String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([studentId, bucket, createdAt, id])
}

model LessonPackage {
  id String @id @default(cuid())
  name String
  quantity Int
  priceAudCents Int
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  entries EntitlementEntry[]
  @@index([active, name, id])
}

model AccountAudit {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation("AccountActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUserId String
  target User @relation("AccountTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  action String
  reason String?
  before Json
  after Json
  requestKey String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([targetUserId, createdAt])
}

model StudentAiReport {
 id String @id @default(cuid())
 taskId String @unique
 task Task @relation("ReportTask", fields: [taskId], references: [id], onDelete: Restrict)
 studentId String
 student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
 sourceFollowupTaskId String @unique
 sourceFollowupTask Task @relation("ReportSource", fields: [sourceFollowupTaskId], references: [id], onDelete: Restrict)
 generationStatus ReportGenerationStatus @default(NOT_STARTED)
 schemaVersion Int @default(1)
 content Json?
 evidenceSnapshot Json?
 inputFingerprint String?
 source String?
 provider String?
 model String?
 generatedAt DateTime? @db.Timestamptz(3)
 lastErrorCode String?
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([studentId, createdAt])
}
